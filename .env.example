DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
ID_PROOFS_BUCKET=id-proofs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable; changing it can make previously encrypted identity numbers unreadable.
ID_NUMBER_ENCRYPTION_KEY=
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Razorpay (use test-mode keys locally)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
# WhatsApp Cloud API (optional; requires an approved template with one body text parameter)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=
# Email (optional — for verification & notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
